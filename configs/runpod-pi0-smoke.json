{
  "dataset": "../data/franka-native-v1/canonical-prepared.json",
  "base_checkpoint": "/workspace/models/pi0-base-torch/model.safetensors",
  "tokenizer": "/workspace/models/tokenizers/paligemma_tokenizer.model",
  "output_dir": "../runs/franka-pi0-smoke",
  "adapter": {
    "feature_dim": 26,
    "heads": 8,
    "context_tokens": 8,
    "relation_types": 8,
    "initial_gate": 0.001
  },
  "action_horizon": 10,
  "precision": "bfloat16",
  "device": "cuda",
  "batch_size": 1,
  "accumulation_steps": 1,
  "steps": 100,
  "learning_rate": 0.0001,
  "weight_decay": 0.01,
  "warmup_steps": 10,
  "gradient_clip": 1.0,
  "graph_dropout": 0.1,
  "eval_every": 5,
  "eval_batches": 2,
  "save_every": 5,
  "seed": 7,
  "gradient_checkpointing": true
}